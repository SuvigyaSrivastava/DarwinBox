# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model used for mapping/cleaning decisions. Llama 3.3 70B is a good balance
# of quality and speed on Groq's free tier.
GROQ_MODEL=llama-3.3-70b-versatile

PORT=8787

# Percentage (0-100) of mock target API pushes that randomly fail, to
# exercise the retry/rollback path. Set to 0 to disable.
MOCK_API_FAILURE_RATE=12

# Only needed for a split deployment (client on a different origin than the
# server, e.g. client on Vercel + server on Render). Restricts CORS to this
# origin instead of leaving it open to any site. Comma-separate multiple
# origins (e.g. your prod domain + a Vercel preview URL). Leave unset for
# local dev — the Vite proxy makes this a non-issue there.
CLIENT_ORIGIN=
