# Only needed for a split deployment (client on Vercel, server elsewhere,
# e.g. Render/Railway). Set to the server's full origin, no trailing slash.
# Leave unset for local dev — requests then go same-origin to "/api" and
# "/ws", which Vite's dev server proxy forwards to the local server
# (see vite.config.ts).
VITE_API_BASE_URL=
